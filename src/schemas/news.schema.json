{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "News",
  "description": "Schema for News items used by the CMS and API",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "description": "Unique numeric identifier (generated by server)",
      "readOnly": true
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly identifier (e.g. community-cleanup-drive)"
    },
    "title": {
      "type": "string",
      "description": "Headline/title of the news item"
    },
    "summary": {
      "type": "string",
      "description": "Short excerpt shown in lists"
    },
    "content": {
      "type": "string",
      "description": "Full body (HTML or Markdown)"
    },
    "image": {
      "type": "array",
      "description": "Array of image URLs or local paths (first image used as cover)",
      "items": { "type": "string" }
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "Publication or event date (ISO 8601). UI currently reads `date` for display."
    },
    "status": {
      "type": "string",
      "enum": ["draft", "published", "archived"],
      "description": "Publication status",
      "default": "draft"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "categories": {
      "type": "array",
      "items": { "type": "string" }
    },
    "author": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "properties": {
            "id": { "type": "integer" },
            "name": { "type": "string" },
            "email": { "type": "string", "format": "email" }
          },
          "required": ["name"]
        }
      ]
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" } }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    }
  },
  "required": ["title"],
  "additionalProperties": false,
  "examples": [
    {
      "title": "Community Cleanup Drive",
      "slug": "community-cleanup-drive",
      "summary": "Volunteers joined to clean up the riverside.",
      "content": "<p>Full article content here.</p>",
      "image": ["/images/events/3.jpg"],
      "date": "2026-06-12T09:00:00Z",
      "status": "published",
      "tags": ["community", "environment"],
      "author": { "name": "Shubhayatra Team" }
    }
  ]
}
